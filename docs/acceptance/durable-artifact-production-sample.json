  "deterministicPolicySummary": {
    "eligibility": "Non-deleted sessions with at least one substantive user message, one narrative assistant message, and 500 combined evidence characters.",
    "protocolEnvelopeExclusions": [
      "AGENTS instructions",
      "environment and permission envelopes",
      "recommended-plugin envelopes",
      "automation SYSTEM envelopes",
      "approval-transcript envelopes",
      "skill bodies",
      "JSON-only approval replies"
    ],
    "deduplication": "Deduplicate exact replay or fork copies by minimum substantive-user text hash; break ties by ascending session ID.",
    "assignmentPrecedence": [
      "sparse",
      "tool_heavy",
      "failure_fix",
      "decision_heavy",
      "ordinary_conversation"
    ],
    "bandPolicies": {
      "sparse": "Exactly one substantive user message and one narrative assistant message, at most two tool calls; order by exchange count, evidence characters, then session ID.",
      "tool_heavy": "Between 400 and 2000 tool calls, excluding hook-event sessions; retain the highest-ranked session per project and order by descending tool calls.",
      "failure_fix": "At least two substantive user and two narrative assistant messages, 1-250 tool calls, at least one user failure-bearing message and one assistant fix-or-verification-bearing message; retain one per project and rank by 3*failure messages + fix messages, then tool calls and session ID.",
      "decision_heavy": "At least three substantive user and three narrative assistant messages, fewer than 400 tool calls, at least two user and two assistant decision-bearing messages; retain one per project and rank by 2*user decision messages + assistant decision messages, then tool calls and session ID.",
      "ordinary_conversation": "From the unassigned remainder: 3-12 substantive user messages, 3-20 narrative assistant messages, at most three tool calls, no failed results or user failure-bearing messages, and at most one user decision-bearing message; rank by distance from ten exchanges, tool calls, evidence characters, then session ID."
    }
  },
