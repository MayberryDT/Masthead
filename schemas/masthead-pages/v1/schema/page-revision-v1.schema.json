{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masthead.page/schema/page-revision-v1.schema.json",
  "title": "PageRevisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "title",
    "summary",
    "body",
    "labels",
    "verification",
    "evidence",
    "provenance",
    "license",
    "generator"
  ],
  "properties": {
    "schemaVersion": { "const": "masthead-page-revision-v1" },
    "kind": { "const": "session_dossier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyWork",
        "decisions",
        "blockers",
        "continuation",
        "warnings"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "keyWork": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "decisions": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "blockers": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openQuestions", "constraints"],
          "properties": {
            "nextStep": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "openQuestions": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "constraints": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "technologies"],
      "properties": {
        "topics": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "technologies": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "checks", "failures"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "mixed", "missing", "unknown"]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "failures": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "text", "supports"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "type": "string", "enum": ["excerpt", "verification"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "supports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": {
              "type": "string",
              "enum": [
                "purpose",
                "outcome",
                "key-work",
                "decisions",
                "blockers",
                "verification",
                "continuation"
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sourceSchema", "sourceLinks"],
      "properties": {
        "sourceKind": { "const": "session_dossier" },
        "sourceSchema": { "const": "canonical-session-dossier-v1" },
        "sourceDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sourceLinks": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rel", "label", "url"],
            "properties": {
              "rel": { "type": "string", "enum": ["repository", "commit"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://"
              }
            }
          }
        }
      }
    },
    "license": {
      "type": "string",
      "enum": ["all-rights-reserved", "cc-by-4.0"]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "projection"],
      "properties": {
        "name": { "const": "Masthead" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "projection": { "const": "session-dossier-public-v1" }
      }
    }
  }
}
