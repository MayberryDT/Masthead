        "outcome": "No HTML execution authority crosses the boundary.",
        "keyWork": [
          "Embedded `code` and ```fence``` markers stay plain strings",
          "Link-like text: https://example.com/path?q=1#frag"
        ],
        "decisions": [
          "Raw HTML is disabled at render time"
        ],
