{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masthead",
  "version": "0.1.0",
  "identifier": "ai.animas.masthead",
  "build": {
    "beforeDevCommand": "MASTHEAD_DAEMON_ENTRY=../dist/daemon/src/daemon/main.js MASTHEAD_NODE_PATH=node npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run prepare:daemon-resources",
    "frontendDist": "../dist"
  },
  "bundle": {
    "resources": [
      "resources/daemon/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Masthead",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  }
}
