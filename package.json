{
  "name": "masthead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/masthead-live-dev.js",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:fixture": "VITE_MASTHEAD_MODE=fixture vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "doctor": "node scripts/masthead-doctor.js",
    "dogfood": "node scripts/masthead-dogfood.js",
    "dogfood:fixture": "node scripts/masthead-dogfood.js",
    "dogfood:live": "node scripts/masthead-dogfood.js --live",
    "ingest": "node scripts/masthead-ingest-server.js",
    "demo:hook": "node scripts/masthead-demo.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
